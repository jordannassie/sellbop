NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public client config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase privileges
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin allowlist for /internal/admin
ADMIN_ALLOWED_EMAILS=admin@sellbop.com

# Optional Printify bootstrap values
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# REQUIRED FOR PAID PURCHASES
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# REQUIRED FOR TRANSACTIONAL EMAIL (purchase receipts, seller notifications)
RESEND_API_KEY=
EMAIL_FROM=SellBop <orders@sellbop.com>
EMAIL_REPLY_TO=hello@sellbop.com
SELLBOP_SUPPORT_EMAIL=hello@sellbop.com

# OPTIONAL — Resend delivery webhook tracking
RESEND_WEBHOOK_SECRET=

# Supabase auth redirect notes:
# - Site URL should match NEXT_PUBLIC_APP_URL in production
# - Add http://localhost:3000/auth/callback
# - Add your Netlify preview callback URLs
# - Add your production callback URL ending in /auth/callback
