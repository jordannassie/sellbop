# ============================================================
# SELLBOP ENVIRONMENT VARIABLES
# Copy this to .env.local and fill in real values.
# The app runs in demo/localStorage mode without these.
# ============================================================

# ── App URL (set to your Netlify domain in production) ───────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SUPABASE ──────────────────────────────────────────────────
# Required for all database reads/writes once Supabase is live.
# Find these in: Supabase Dashboard → Project → API Settings
#
#   NEXT_PUBLIC_SUPABASE_URL        → Add to Netlify + .env.local
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   → Add to Netlify + .env.local
#   SUPABASE_SERVICE_ROLE_KEY       → Add to Netlify ONLY (server-side secret, never public)
#
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── PRINTIFY ──────────────────────────────────────────────────
# Optional: set these to skip the in-app "Connect Printify" form.
# If not set, sellers connect via the Dashboard → Clothing page.
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=

# ── STRIPE (future) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# ── EMAIL / RESEND (future) ───────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@sellbop.com
