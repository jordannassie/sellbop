{"lastModified":1776737550766,"value":{"kind":"APP_PAGE","html":"<!DOCTYPE html><html lang=\"en\" class=\"geist_9e050971-module__05dp7a__className\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/caa3a2e1cccd8315-s.p.16t1db8_9y2o~.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/17h78v4ybvik4.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0yb2wil16uz6h.js\"/><script src=\"/_next/static/chunks/0-~o727nja1lo.js\" async=\"\"></script><script src=\"/_next/static/chunks/10~x95jhs6ns3.js\" async=\"\"></script><script src=\"/_next/static/chunks/00nlt7x_9mi4z.js\" async=\"\"></script><script src=\"/_next/static/chunks/0usj8uycfz8~2.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-0cc3pg77jf~.k.js\" async=\"\"></script><script src=\"/_next/static/chunks/05.792sthqbxu.js\" async=\"\"></script><script src=\"/_next/static/chunks/0n4z.7yu76je-.js\" async=\"\"></script><script src=\"/_next/static/chunks/0xjfhpbej_t.5.js\" async=\"\"></script><script src=\"/_next/static/chunks/0-xwh173f54l1.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Privacy Policy — SellBop.com</title><meta name=\"description\" content=\"SellBop Privacy Policy — how we collect, use, and protect your personal information.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0x3dzn~oxb6tn.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/03~yq9q893hmn.js\" noModule=\"\"></script></head><body class=\"bg-white text-neutral-900 antialiased\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur border-b border-neutral-100\"><div class=\"max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-between h-14\"><a href=\"/\"><a class=\"inline-fle